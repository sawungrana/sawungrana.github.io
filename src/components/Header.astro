---
import Mark from "./Mark.astro";

const links = [
  { href: "/cv", label: "cv" },
  { href: "/work", label: "work" },
  { href: "/colophon", label: "colophon" },
];

const path = Astro.url.pathname;
---
<header class="border-b rule-line">
  <div class="mx-auto flex max-w-4xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-5">
    <a href="/" class="flex items-center gap-2.5 text-ink-deep no-underline">
      <span class="text-ink"><Mark size={18} /></span>
      <span class="text-[1.02rem] font-semibold tracking-wide">Azzadiva Sawungrana</span>
    </a>
    <nav aria-label="sections" class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.95rem]">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              "no-underline",
              path.startsWith(l.href)
                ? "font-semibold text-ink-deep"
                : "text-ink-soft hover:text-accent",
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <span aria-hidden="true" class="text-rule-strong">|</span>
      <a href="https://lantip.space" class="text-ink-soft no-underline hover:text-accent">
        lantip.space
      </a>
    </nav>
  </div>
</header>
