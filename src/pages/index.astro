---
import Base from "../layouts/Base.astro";
import Rule from "../components/Rule.astro";
import Stamp from "../components/Stamp.astro";
import Frieze from "../components/Frieze.astro";
import headerBand from "../ornaments/header-band.svg?raw";

const elsewhere = [
  { href: "https://lantip.space", label: "lantip.space" },
  { href: "https://github.com/sawungrana", label: "github" },
  { href: "https://www.linkedin.com/in/sawungrana", label: "linkedin" },
  { href: "mailto:azzadv@outlook.com", label: "email" },
];
---
<Base
  title="Azza Sawungrana — geospatial data platforms"
  description="Head of Data at Geosquare. I build geospatial data platforms, and I turn bespoke delivery into products that sell twice."
>
  <div class="ornament w-full text-ink/35" aria-hidden="true" set:html={headerBand}></div>

  <div class="mx-auto max-w-4xl px-6">
    <div class="relative mt-4 flex flex-col gap-8 md:mt-10 md:flex-row md:items-start md:gap-12">
      <img
        src="/portrait.webp"
        width="800"
        height="800"
        alt="Azza Sawungrana"
        class="cameo relative z-10 h-28 w-28 shrink-0 object-cover md:h-36 md:w-36"
        loading="eager"
      />

      <div class="relative z-10">
        <p class="stamp-text text-ink-soft">klaten, indonesia</p>
        <h1 class="mt-3 text-[2rem] leading-[1.1] text-ink-deep md:text-[2.6rem]">
          Azza Sawungrana
        </h1>
        <p class="mt-5 max-w-xl text-[1.18rem] leading-[1.5] text-ink-deep">
          I work on geospatial data platforms, mostly the plumbing: national datasets, what
          they cost to serve, and who can run them without me.
        </p>
      </div>
    </div>

    <Rule />

    <div class="max-w-2xl space-y-5">
      <p>
        Head of Data at Geosquare, where we turn national datasets into location intelligence
        for land, hazard, property and mobility. I wrote the platform strategy, and I am
        building the recurring product now.
      </p>
      <p>
        Before that I led product at Bhumi Varta for three years, and before that I was a
        cartographer who kept running into the limit of doing things by hand. Somewhere in
        between I stopped making maps and started writing the software that makes them.
      </p>
      <p class="text-ink-soft">
        The tools that came out of that are at{" "}
        <a href="https://lantip.space">lantip.space</a>, which is a workshop rather than a
        portfolio. This site is the quieter one: the <a href="/cv">CV</a>, the{" "}
        <a href="/work">work</a>, and a short account of how it is made.
      </p>
    </div>

    <Frieze
      src="/plates/indies.webp"
      alt="Nederlandsch Indie, 1873: an engraved map of the Indonesian archipelago"
      caption="nederlandsch indie, 1873 · public domain, via wikimedia commons"
    />

    <Rule tight />

    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pb-4">
      <Stamp label="elsewhere" />
      {
        elsewhere.map((l) => (
          <a href={l.href} class="stamp-text text-ink-soft no-underline hover:text-accent">
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</Base>
