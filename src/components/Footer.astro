---
const year = new Date().getFullYear();
const links = [
  { href: "https://lantip.space", label: "lantip.space" },
  { href: "https://github.com/sawungrana", label: "github" },
  { href: "https://www.linkedin.com/in/sawungrana", label: "linkedin" },
];
---
<footer class="mt-24 border-t rule-line">
  <div class="pt-8 pb-6">
    <div class="mx-auto max-w-4xl px-6">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="text-ink-deep">Azza Sawungrana · geospatial data platforms</p>
          <p class="text-[0.95rem] text-ink-soft">Klaten, Indonesia</p>
        </div>
        <nav class="stamp-text flex flex-wrap gap-x-5 gap-y-2" aria-label="elsewhere">
          {
            links.map((l) => (
              <a href={l.href} class="text-ink-soft no-underline hover:text-accent">
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>
      <p class="stamp-text mt-6 text-ink-soft/80">
        no analytics · no cookies · no newsletter · {year}
      </p>
    </div>
  </div>
  <div class="border-t rule-line">
    <img
      src="/plates/footer-strip.webp"
      width="1600"
      height="720"
      alt="Oudheidkundige kaart van West- en Midden-Java, engraved map of the north coast"
      class="mx-auto block h-[170px] w-full max-w-[1600px] object-cover md:h-[230px]"
      loading="lazy"
    />
  </div>
</footer>
