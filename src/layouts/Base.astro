---
import "@fontsource-variable/eb-garamond";
import "@fontsource/fragment-mono/400.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { cv } from "../lib/cv";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = "/og.png" } = Astro.props;
const site = Astro.site ?? new URL("https://sawungrana.github.io");
const canonical = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(ogImage, site).href;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: cv.person.name,
  alternateName: cv.person.legalName ?? cv.person.displayName,
  jobTitle: cv.person.headline,
  description: cv.person.positioning,
  url: site.href,
  email: `mailto:${cv.person.email}`,
  address: { "@type": "PostalAddress", addressLocality: "Klaten", addressCountry: "ID" },
  sameAs: cv.person.links.map((link) => link.href),
  knowsAbout: [
    "Geospatial data platforms",
    "Remote sensing",
    "Spatial data engineering",
    "Location intelligence",
    "Discrete global grid systems",
  ],
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sawungrana.github.io" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" is:inline set:html={jsonLd} />
    <meta name="theme-color" content="#f5f0e6" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link stamp-text" href="#main">skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
