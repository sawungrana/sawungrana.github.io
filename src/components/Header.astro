---
import Mark from "./Mark.astro";
---
<header class="border-b rule-line">
  <div class="mx-auto flex max-w-4xl items-center justify-between gap-6 px-6 py-5">
    <a href="/" class="flex items-center gap-2.5 text-ink-deep no-underline">
      <span class="text-ink"><Mark size={18} /></span>
      <span class="text-[1.02rem] font-semibold tracking-wide">Azzadiva Sawungrana</span>
    </a>
    <nav aria-label="sections" class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[0.95rem]">
      <a href="https://lantip.space" class="text-ink-soft no-underline hover:text-accent">lantip.space</a>
    </nav>
  </div>
</header>
